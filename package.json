{
  "name": "codex-animation-builder",
  "version": "0.7.9",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js && esbuild server/export-worker.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/export-worker.js",
    "start": "node dist/server.js",
    "preview": "node dist/server.js --web",
    "test": "node scripts/test.mjs",
    "check": "tsc --noEmit",
    "dev": "pnpm build && pnpm preview",
    "browser:install": "node scripts/install-browser.mjs",
    "package": "node scripts/package.mjs",
    "build:beta": "node scripts/build-beta.mjs",
    "build:beta:windows": "node scripts/build-beta.mjs --platform=win32",
    "test:startup": "node --test scripts/test-startup.mjs",
    "test:host-startup": "node scripts/test-host-startup.mjs"
  },
  "dependencies": {
    "@galacean/editor-ui": "^1.2.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "pixi.js": "^8.22.0",
    "playwright": "^1.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^6.4.0",
    "vite-plugin-singlefile": "^2.3.0",
    "sharp": "^0.34.0"
  }
}
